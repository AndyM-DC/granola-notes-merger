{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["DOM", "ESNext"],
    "baseUrl": ".",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": false,
    "noImplicitAny": true,
    "strict": true,
    "importHelpers": false,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
